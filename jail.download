[nginx-http-auth]
enabled  = true
filter   = nginx-http-auth
logpath  = /var/log/nginx/error.log
maxretry = 3
bantime  = 3600
findtime = 600

[nginx-wp-scanner]
enabled  = true
filter   = nginx-wp-scanner
action   = iptables[name=WPScanner, port=http, protocol=tcp]
logpath  = /var/log/nginx/access.log
maxretry = 1
bantime  = 86400

[nginx-404]
enabled  = true
filter   = nginx-404
port     = http,https
logpath  = /var/log/nginx/access.log
maxretry = 5
findtime = 600
bantime  = 86400